{
  "name": "@data-room/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:seed:reset": "prisma db seed -- --reset"
  },
  "dependencies": {
    "@data-room/contracts": "*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@ts-rest/core": "3.52.1",
    "@ts-rest/express": "3.52.1",
    "@vercel/blob": "2.8.0",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "jsonwebtoken": "9.0.3",
    "pino": "10.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.3",
    "pino-pretty": "13.1.3",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
