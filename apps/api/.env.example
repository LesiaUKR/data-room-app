# Copy this file to apps/api/.env and fill in real values.
# .env is never committed — it holds credentials.

# --- Runtime ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# --- Database (Neon) ---
# Pooled endpoint, used by the application at runtime. Note the "-pooler" host and
# connection_limit=1: a serverless invocation must not open more than one connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&connection_limit=1

# Direct (unpooled) endpoint, used only by Prisma Migrate. DDL cannot run through the pooler.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# --- Auth ---
# Signing key for the session token. Anyone holding it can mint a token for any user.
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Storage (Vercel Blob, private store) ---
# Server-side only. The browser never receives it — it gets short-lived signed URLs instead.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# --- Web ---
# Origin of the SPA. Only needed as the fallback if the same-origin /api rewrite stops holding
# and explicit CORS has to be enabled.
WEB_ORIGIN=http://localhost:5173
