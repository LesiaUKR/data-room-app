{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://data-room-app-api.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
